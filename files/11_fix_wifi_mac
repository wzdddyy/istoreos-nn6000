[ "$ACTION" == "add" ] || exit 0

PHYNBR=${DEVPATH##*/phy}

[ -n $PHYNBR ] || exit 0

. /lib/functions.sh
. /lib/functions/system.sh

case "$(board_name)" in
	link,nn6000-v1|\
	link,nn6000-v2)
		label_mac=$(mmc_get_mac_binary 0:ART 0x18)
		[ "$PHYNBR" = "0" ] && macaddr_add $label_mac -4 > /sys${DEVPATH}/macaddress
		[ "$PHYNBR" = "1" ] && macaddr_add $label_mac -5 > /sys${DEVPATH}/macaddress
		;;
esac
